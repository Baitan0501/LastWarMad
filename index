<!DOCTYPE html>
<html lang="ru">
<head>
    <link rel="icon" type="image/png" href="https://github.com/Baitan0501/LastWarMad/blob/main/ico.png?raw=true">
    <link rel="apple-touch-icon" href="https://github.com/Baitan0501/LastWarMad/blob/main/ico.png?raw=true">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Last War: Desert Storm Strategy</title>
    <style>
        body { font-family: 'Segoe UI', Arial, sans-serif; background-color: #1a1a1a; color: #e0e0e0; margin: 0; padding: 15px; line-height: 1.5; }
        .container { max-width: 900px; margin: 0 auto; background: #262626; padding: 20px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
        h1 { text-align: center; color: #f1c40f; text-transform: uppercase; font-size: 1.4em; margin-bottom: 15px; }
        .lang-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 6px; margin-bottom: 20px; }
        .lang-btn { padding: 8px; cursor: pointer; border: 1px solid #444; border-radius: 4px; background: #333; color: #fff; transition: 0.2s; font-size: 11px; }
        .lang-btn:hover { border-color: #f1c40f; }
        .lang-btn.active { background: #f1c40f; color: #000; font-weight: bold; border-color: #f1c40f; }
        .strategy-text { background: #333; padding: 18px; border-radius: 8px; border-left: 5px solid #f1c40f; margin-bottom: 15px; min-height: 250px; }
        .strategy-text p { margin: 0 0 10px 0; font-size: 14px; }
        .image-container { text-align: center; margin-bottom: 20px; }
        img { max-width: 100%; border-radius: 8px; border: 2px solid #444; }
        .rtl { direction: rtl; text-align: right; border-left: none; border-right: 5px solid #f1c40f; }
        
        .links-container { 
            background: #333; 
            padding: 12px; 
            border-radius: 8px; 
            margin-bottom: 20px; 
            border: 1px solid #444;
            display: flex;
            flex-direction: column;
            align-items: flex-start; 
        }
        .links-title { color: #f1c40f; font-size: 0.9em; font-weight: bold; text-transform: uppercase; margin-bottom: 10px; }
        .link-item { display: inline-flex; align-items: center; color: #fff; text-decoration: none; font-size: 14px; background: #444; padding: 8px 15px; border-radius: 6px; transition: 0.2s; }
        .link-item:hover { background: #555; border-color: #f1c40f; }
        .truck-icon { font-size: 18px; margin-right: 10px; filter: drop-shadow(0 0 2px #f1c40f); }

        #strategyMap { cursor: zoom-in; transition: transform 0.3s ease; }
        #strategyMap:hover { transform: scale(1.01); border-color: #f1c40f; }

        /* Стили для раздела Tactics */
        .tactics-section { margin-top: 30px; padding-top: 20px; border-top: 2px dashed #444; }
        .tactics-title { color: #f1c40f; text-align: center; text-transform: uppercase; font-size: 1.2em; margin-bottom: 20px; }
        .tactics-subtitle { color: #fff; background: #c0392b; display: inline-block; padding: 5px 15px; border-radius: 4px; font-weight: bold; margin-bottom: 15px; font-size: 14px; }
        .illustration-card { background: #333; border-radius: 8px; padding: 10px; margin-bottom: 20px; border: 1px solid #555; text-align: center; }
        .illustration-card img { width: 100%; height: auto; display: block; margin-top: 10px; cursor: zoom-in; }
        .img-caption { font-size: 13px; color: #f1c40f; font-weight: bold; margin-top: 8px; display: block; }
    </style>
</head>
<body>

<div class="container">
    <h1>Desert Storm Strategy</h1>

    <div class="links-container">
        <div class="links-title">LINK</div>
        <a href="https://cpt-hedge.com/servers" target="_blank" class="link-item">
            <span class="truck-icon">🚚</span> secret missions
        </a>
    </div>

    <div class="lang-grid" id="langGrid"></div>
    <div class="strategy-text" id="content"></div>
    
    <div class="image-container">
        <img id="strategyMap" src="" alt="Strategy Map">
    </div>

    <div class="tactics-section">
        <div class="tactics-title">Tactics</div>
        <div class="tactics-subtitle">Save the soldiers!</div>

        <div class="illustration-card">
            <span class="img-caption">1. The strongest squad is on the wall!</span>
            <img src="https://github.com/Baitan0501/LastWarMad/blob/main/S1.png?raw=true" alt="Strongest squad" onclick="openModal(this.src)">
        </div>

        <div class="illustration-card">
            <span class="img-caption">2. Conduct reconnaissance of the enemy</span>
            <img src="https://github.com/Baitan0501/LastWarMad/blob/main/S2.png?raw=true" alt="Reconnaissance" onclick="openModal(this.src)">
        </div>

        <div class="illustration-card">
            <span class="img-caption">3. Assess the enemy's strength, DO NOT attack whales!</span>
            <img src="https://github.com/Baitan0501/LastWarMad/blob/main/S3.png?raw=true" alt="Assess strength" onclick="openModal(this.src)">
        </div>
    </div>
</div>

<div id="modal" onclick="this.style.display='none'" style="display:none; position:fixed; z-index:1000; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,0.9); cursor:zoom-out; align-items:center; justify-content:center;">
    <img id="modalImg" style="max-width:95%; max-height:95%; border:2px solid #f1c40f; border-radius:8px;">
</div>

<script>
    const translations = {
        ru: { name: "Русский", flag: "🇷🇺", text: `<p><strong>1.</strong> Заходим на поле боя и делимся на группы согласно схеме на рисунке (сделайте это до начала боя).</p><p><strong>2. Захват зданий:</strong> Гр. 1 — Нефть 1, Гр. 2 — Нефть 2, Гр. 3 — Госпиталь 1, Гр. 4 — Госпиталь 2, Гр. 5 — Инфо-центр, Гр. 6 — Госпиталь 3, Гр. 7 — Научный хаб.</p><p><strong>3. Через 10 минут (Ядерная шахта):</strong> Гр. 6 полностью уходит на захват шахты. Из Гр. 4: двое идут на шахту, один на Нефть 2. Гр. 3 покидает госпиталь: двое на Нефть 1, один в Инфо-центр.</p><p><strong>4. Киты (Топ-4):</strong> Перемещайтесь между зданиями, сжигайте врагов и помогайте там, где группы не справляются.</p><p><strong>5. Советы:</strong> Уберите войска со стен (оставьте только 1 сильный отряд), делайте разведку, ловите врага на марше. Удержим здания — победим!</p>` },
        ua: { name: "Українська", flag: "🇺🇦", text: `<p><strong>1.</strong> Заходимо на поле бою та ділимося на групи за схемою на малюнку (зробіть це до початку бою).</p><p><strong>2. Захоплення будівель:</strong> Гр. 1 — Нафта 1, Гр. 2 — Нафта 2, Гр. 3 — Шпиталь 1, Гр. 4 — Шпиталь 2, Гр. 5 — Інфо-центр, Гр. 6 — Шпиталь 3, Гр. 7 — Науковий хаб.</p><p><strong>3. Через 10 хвилин (Ядерна шахта):</strong> Гр. 6 повністю йде на шахту. З Гр. 4: двоє на шахту, один на Нафту 2. Гр. 3 залишає шпиталь: двоє на Нафту 1, один в Інфо-центр.</p><p><strong>4. Кити (Топ-4):</strong> Літайте між будівлями, паліть ворогів та допомагайте там, де основні групи не справляються.</p><p><strong>5. Поради:</strong> Приберіть війська зі стін (залиште 1 сильний загін), робіть розвідку. Втримаємо будівлі — переможемо!</p>` },
        en: { name: "English", flag: "🇺🇸", text: `<p><strong>1.</strong> Enter the battlefield and divide into groups according to the scheme before the battle starts.</p><p><strong>2. Objective:</strong> Gr 1 — Oil 1, Gr 2 — Oil 2, Gr 3 — Hospital 1, Gr 4 — Hospital 2, Gr 5 — Info Center, Gr 6 — Hospital 3, Gr 7 — Science Hub.</p><p><strong>3. After 10 min (Nuclear Silo):</strong> Gr 6 moves entirely to the Silo. From Gr 4: 2 players to Silo, 1 to Oil 2. Gr 3 leaves hospital: 2 players to Oil 1, 1 to Info Center.</p><p><strong>4. Whales (Top 4):</strong> Move between buildings, burn enemy bases, and provide support where groups are struggling.</p><p><strong>5. Tips:</strong> Clear your walls (keep only the strongest march), scout enemies, and attack when they are out. Hold the buildings to win!</p>` },
        es: { name: "Español", flag: "🇪🇸", text: `<p><strong>1.</strong> Entren al campo de batalla y divídanse según el esquema.</p><p><strong>2. Captura:</strong> G1 — Petróleo 1, G2 — Petróleo 2, G3 — Hospital 1, G4 — Hospital 2, G5 — Centro de Info, G6 — Hospital 3, G7 — Centro de Ciencia.</p><p><strong>3. Tras 10 min (Silo Nuclear):</strong> G6 va al Silo. Del G4: 2 al Silo, 1 al Petróleo 2. G3 deja el hospital.</p><p><strong>4. Ballenas (Top 4):</strong> Vuelen entre edificios, destruyan enemigos.</p><p><strong>5. Consejos:</strong> Quiten tropas del muro, exploren y ataquen.</p>` },
        de: { name: "Deutsch", flag: "🇩🇪", text: `<p><strong>1.</strong> Schlachtfeld betreten и т.д.</p>` },
        fr: { name: "Français", flag: "🇫🇷", text: `<p><strong>1.</strong> Entrez sur le champ de bataille...</p>` },
        it: { name: "Italiano", flag: "🇮🇹", text: `<p><strong>1.</strong> Entrate in campo...</p>` },
        tr: { name: "Türkçe", flag: "🇹🇷", text: `<p><strong>1.</strong> Savaş başlamadan...</p>` },
        pl: { name: "Polski", flag: "🇵🇱", text: `<p><strong>1.</strong> Wejdź na pole bitwy...</p>` },
        kz: { name: "Қазақша", flag: "🇰🇿", text: `<p><strong>1.</strong> Шайқас басталғанша...</p>` },
        pt: { name: "Português", flag: "🇧🇷", text: `<p><strong>1.</strong> Entre no campo...</p>` },
        nl: { name: "Nederlands", flag: "🇳🇱", text: `<p><strong>1.</strong> Betreed het slagveld...</p>` },
        se: { name: "Svenska", flag: "🇸🇪", text: `<p><strong>1.</strong> Gå in på slagfältet...</p>` },
        cn: { name: "中文 (简体)", flag: "🇨🇳", text: `<p><strong>1.</strong> 战斗开始前...</p>` },
        tw: { name: "中文 (繁體)", flag: "🇭🇰", text: `<p><strong>1.</strong> 戰鬥開始前...</p>` },
        jp: { name: "日本語", flag: "🇯🇵", text: `<p><strong>1.</strong> 戦闘開始前に...</p>` },
        kr: { name: "한국어", flag: "🇰🇷", text: `<p><strong>1.</strong> 전투 시작 전...</p>` },
        my: { name: "Malay", flag: "🇲🇾", text: `<p><strong>1.</strong> Masuk ke medan...</p>` },
        id: { name: "Bahasa Indonesia", flag: "🇮🇩", text: `<p><strong>1.</strong> Masuk ke medan...</p>` },
        ae: { name: "العربية", flag: "🇦🇪", text: `<p><strong>1.</strong> ادخل ساحة المعركة...</p>`, isRtl: true }
    };

    const langGrid = document.getElementById('langGrid');
    const contentDiv = document.getElementById('content');
    const modal = document.getElementById('modal');
    const modalImg = document.getElementById('modalImg');

    // Функция открытия модалки
    function openModal(src) {
        if (src && src.indexOf('ССЫЛКА') === -1) {
            modal.style.display = "flex";
            modalImg.src = src;
        }
    }

    // Создание кнопок
    Object.keys(translations).forEach(key => {
        const btn = document.createElement('button');
        btn.className = 'lang-btn';
        btn.innerText = translations[key].name;
        btn.onclick = () => {
            contentDiv.innerHTML = translations[key].text;
            contentDiv.className = 'strategy-text' + (translations[key].isRtl ? ' rtl' : '');
            document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        };
        langGrid.appendChild(btn);
    });

    // Оживление основной карты
    const mapImg = document.getElementById('strategyMap');
    mapImg.src = "https://github.com/Baitan0501/LastWarMad/blob/main/Screenshot_34.png?raw=true&v=2";
    mapImg.onclick = function() { openModal(this.src); };

    // Авто-клик на первую кнопку
    if (langGrid.firstChild) langGrid.firstChild.click();
</script>

</body>
</html>
